# ==============================================================================
# Bazar Dor (বাজার দর) — Environment Variables Template
# Copy these variables into Vercel Project Settings > Environment Variables
# ==============================================================================

# Live API Endpoint for commodity data
NEXT_PUBLIC_BAZAR_DOR_API_URL=https://openapi.programming-hero.com/api/bazardor

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=bazar_dor

# Better Auth Secret (32-byte base64 string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Better Auth Canonical URL (CRITICAL: Production domain without trailing slash)
# Local: http://localhost:3000
# Production: https://bazar-dor-23.vercel.app
BETTER_AUTH_URL=https://bazar-dor-23.vercel.app

# Google OAuth 2.0 Credentials
# Callback URI in Google Console: https://bazar-dor-23.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App Credentials
# Callback URL in GitHub Settings: https://bazar-dor-23.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
